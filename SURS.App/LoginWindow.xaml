<Window x:Class="SURS.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="720" Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="116"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#4A90E2">
            <StackPanel Margin="42,24,42,18">
                <TextBlock Text="SURS" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="妇科超声结构化报告系统" Foreground="#EAF4FF" FontSize="15" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Margin="48,30,48,22" CornerRadius="10"
                BorderBrush="#E3EAF2" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#8297B3" BlurRadius="20" ShadowDepth="3" Opacity="0.16"/>
            </Border.Effect>
            <Grid Margin="38,28,38,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Heading}" FontSize="23" FontWeight="SemiBold" Foreground="#1E2B3C"/>
                <TextBlock Grid.Row="1" Text="{Binding Subheading}" TextWrapping="Wrap" Foreground="#65758A"
                           Margin="0,8,0,18" LineHeight="22"/>

                <StackPanel Grid.Row="2" Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="激活卡号" Foreground="#35465C" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="72" MaxHeight="94" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Padding="11,9" BorderBrush="#C9D5E3" BorderThickness="1"
                             FontFamily="Consolas" FontSize="12" Margin="0,0,0,15"/>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="账号" Foreground="#35465C" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox x:Name="AccountInput"
                             Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" Padding="11,8" BorderBrush="#C9D5E3" BorderThickness="1"
                             VerticalContentAlignment="Center" Margin="0,0,0,15"/>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="密码" Foreground="#35465C" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <PasswordBox x:Name="PasswordInput" Height="42" Padding="11,8"
                                 BorderBrush="#C9D5E3" BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="5" Background="#FFF4E5" BorderBrush="#F2C46D" BorderThickness="1"
                        CornerRadius="5" Padding="10,8" Margin="0,14,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#A85B00" TextWrapping="Wrap"/>
                </Border>

                <Border Grid.Row="6" Background="#EDF7F1" BorderBrush="#BFE3CC" BorderThickness="1"
                        CornerRadius="5" Padding="11,9" Margin="0,14,0,0" VerticalAlignment="Top"
                        Visibility="{Binding StatusText, Converter={StaticResource StringToVis}}">
                    <TextBlock Text="{Binding StatusText}" Foreground="#23633E" TextWrapping="Wrap" LineHeight="21"/>
                </Border>

                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="退出" Width="92" Height="40" Margin="0,0,12,0"
                            Click="CancelButton_Click" Background="#EEF2F6" BorderBrush="#D5DEE8"/>
                    <Button x:Name="LoginButton" Content="{Binding LoginButtonText}" Width="126" Height="40"
                            IsDefault="True" Click="LoginButton_Click"
                            Background="#4A90E2" Foreground="White" BorderBrush="#357ABD"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="纯离线授权 · 软件不访问外网 · 授权自首次激活当刻起算"
                   Foreground="#7B8B9F" FontSize="12"/>
    </Grid>
</Window>