<Window x:Class="SURS.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="780" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">

    <Window.Resources>
        <!-- ===== 字段标签 ===== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A596E"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ===== 单行输入框（账号等） ===== -->
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1F2F44"/>
            <Setter Property="CaretBrush" Value="#4A90E2"/>
            <Setter Property="Background" Value="#FBFDFF"/>
            <Setter Property="BorderBrush" Value="#CBD8E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A90E2"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 激活卡号：多行展示，纵向加高，整卡可见 ===== -->
        <Style x:Key="CardTextBox" TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
            <Setter Property="Height" Value="84"/>
            <Setter Property="Padding" Value="13,10,13,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Top"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A90E2"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 密码框 ===== -->
        <Style x:Key="PasswordInput" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1F2F44"/>
            <Setter Property="Background" Value="#FBFDFF"/>
            <Setter Property="BorderBrush" Value="#CBD8E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A90E2"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 错误 / 状态横幅 ===== -->
        <Style x:Key="ErrorBanner" TargetType="Border">
            <Setter Property="Background" Value="#FFF4E5"/>
            <Setter Property="BorderBrush" Value="#F2C46D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StatusBanner" TargetType="Border">
            <Setter Property="Background" Value="#EDF7F1"/>
            <Setter Property="BorderBrush" Value="#BFE3CC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- ===== 主按钮（胶囊） ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="21" Padding="24,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#357ABD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C6CA8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 次按钮（退出） ===== -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Background" Value="#F2F5F9"/>
            <Setter Property="Foreground" Value="#42536A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#D5DEE8" BorderThickness="1" CornerRadius="21" Padding="22,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E7EDF4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDE6F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="116"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部品牌条 ===== -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#5A9FE8" Offset="0"/>
                    <GradientStop Color="#3A7BD5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="44,0,44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="13" Background="#22FFFFFF" VerticalAlignment="Center">
                    <TextBlock Text="S" FontSize="25" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SURS" Foreground="White" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="妇科超声结构化报告系统" Foreground="#EAF4FF" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#22FFFFFF" CornerRadius="16" Padding="16,7" VerticalAlignment="Center">
                    <TextBlock Text="离线单机 · 医院内网使用" Foreground="White" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 中间表单卡片 ===== -->
        <Border Grid.Row="1" Background="White" Margin="50,26,50,20" CornerRadius="12"
                BorderBrush="#E3EAF2" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#8297B3" BlurRadius="24" ShadowDepth="3" Opacity="0.15"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="40,32,40,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" Foreground="#1E2B3C"/>

                    <TextBlock Grid.Row="1" Text="{Binding Subheading}" TextWrapping="Wrap" Foreground="#65758A"
                               Margin="0,6,0,18" LineHeight="21"/>

                    <!-- 激活卡号：纵向加高，正卡完整可见；自动带出/粘贴的整串授权号在此完整显示 -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,18"
                                Visibility="{Binding IsCardInputVisible, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="激活卡号" Foreground="#4A596E" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Grid.Column="2" Text="粘贴《交付单》上的完整 SURS2... 授权串"
                                       Foreground="#9AA7B8" FontSize="11"/>
                        </Grid>
                        <TextBox x:Name="CardInput"
                                 Text="{Binding CardCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CardTextBox}"
                                 ToolTip="粘贴交付单中的完整 SURS2... 激活卡号"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,18">
                        <TextBlock Text="账号" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="AccountInput"
                                 Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordInput}"/>
                    </StackPanel>

                    <Border Grid.Row="5" Style="{StaticResource ErrorBanner}"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#A85B00" TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="6" Style="{StaticResource StatusBanner}"
                            Visibility="{Binding StatusText, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding StatusText}" Foreground="#23633E" TextWrapping="Wrap" LineHeight="20"/>
                    </Border>

                    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="退出" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"
                                IsCancel="True" Click="CancelButton_Click"/>
                        <Button x:Name="LoginButton" Content="{Binding LoginButtonText}"
                                Style="{StaticResource PrimaryButton}" IsDefault="True"
                                Click="LoginButton_Click"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="纯离线授权 · 软件不访问外网 · 授权自首次激活当刻起算"
                   Foreground="#7B8B9F" FontSize="12"/>
    </Grid>
</Window>