<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SURS.LicenseTool</RootNamespace>
    <AssemblyName>SURS.LicenseTool</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      复用验证端（SURS.App）同源文件，保证“签发/验证/自检”三端协议完全一致，
      避免最常见的“两端实现漂移导致合法卡被拒绝”的问题。
      注意：本文件仅依赖 BCL，不得引用任何 WPF / UI 类型。
    -->
    <Compile Include="..\..\SURS.App\Services\License\LicenseCrypto.cs" Link="LicenseCrypto.cs" />
  </ItemGroup>

</Project>